---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Comments from '../../components/Comments.astro';
import { allPosts, categoryOf, tagsOf, formatDate } from '../../lib/posts';
export async function getStaticPaths() { return (await allPosts()).map(post => ({ params: { slug: post.data.slug }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description} wide>
  <div class="article-shell"><TableOfContents headings={headings} /><article data-pagefind-body>
    <header class="article-header"><a class="back-link" data-pagefind-ignore href="/blog/">← 所有文章</a><div class="post-meta" data-pagefind-ignore><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>{categoryOf(post) && <a href={`/categories/${encodeURIComponent(categoryOf(post)!)}/`}>{categoryOf(post)}</a>}</div><h1 data-pagefind-meta="title">{post.data.title}</h1><div class="tags" data-pagefind-ignore>{tagsOf(post).map(tag => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}</div></header>
    <div class="prose"><Content /></div>
    <div class="article-end" data-pagefind-ignore><span aria-hidden="true">✳</span><a href="/blog/">回到文章列表 ↗</a></div>
    <Comments />
  </article></div>
</BaseLayout>
