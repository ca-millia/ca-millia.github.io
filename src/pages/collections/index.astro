---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { editorialCollections } from '../../lib/posts';
---
<BaseLayout title="合集"><header class="page-heading"><p class="eyebrow">A FEW THINGS TOGETHER</p><h1>合集</h1><p>把有关联的文章放在一起，慢慢读成一段完整的故事。</p></header><div class="collection-grid">{editorialCollections.map(collection => <a class="collection-card" href={`/collections/${collection.slug}/`}><span class="eyebrow">{collection.posts.length} 篇文章</span><h2>{collection.title}</h2><p>{collection.description}</p><span aria-hidden="true">↗</span></a>)}</div>{editorialCollections.length === 0 && <p class="empty-state">还在整理中。先从<a href="/blog/">一篇文章</a>开始吧。</p>}</BaseLayout>
