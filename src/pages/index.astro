---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import HomeMusic from '../components/HomeMusic.astro';
import { allPosts } from '../lib/posts';
const posts = await allPosts();
---
<BaseLayout>
  <section class="home-intro">
    <div class="intro-profile">
      <img
        class="intro-avatar"
        src="/img/portrait.jpg"
        alt="camillia 的头像"
        width="144"
        height="144"
      />

      <div class="intro-content">
        <h1 class="intro-hello">
          ¡Hola，这里是 <strong>camillia</strong>！🌻🥕🐖
        </h1>
        <p class="intro-quote">
          我们这一生，唯有文字能担此重任，宣告生命曾经在场
        </p>
        <p class="intro-meta">
          此地正式诞生于 2025-12-05，重构于 2026-09-28<br class="desktop-break" />
          主要用来
          <strong>知识分享 / 个人记录 / 文章创作</strong>
        </p>
      </div>
    </div>

    <HomeMusic />
  </section>

  <section aria-labelledby="recent-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">RECENT WRITING</p>
        <h2 id="recent-heading">最近写下的</h2>
      </div>

      <a href="/blog/">
        全部文章 <span aria-hidden="true">↗</span>
      </a>
    </div>

    <PostList posts={posts.slice(0, 1)} />
  </section>

</BaseLayout>
